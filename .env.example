APP_NAME="Alunos da Medicina"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://alunosdamedicina.com

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nome_do_banco
DB_USERNAME=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_CHARSET=utf8mb4

# n8n / Assistente de Estudos
N8N_AI_WEBHOOK_URL=
N8N_AI_WEBHOOK_TOKEN=
N8N_AI_TIMEOUT=90

# OpenAI / Professor ao Vivo
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TIMEOUT=30
# Auditoria / Professor ao Vivo
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
REALTIME_AUDIT_ENABLED=true
